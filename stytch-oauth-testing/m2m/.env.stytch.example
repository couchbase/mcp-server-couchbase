# Copy to .env.stytch and fill in. .env.stytch is git-ignored.

# --- One-time: from Stytch dashboard → Project settings → API keys ----------
STYTCH_ENV=test                       # "test" or "live"
STYTCH_PROJECT_ID=project-test-b02791c9-6f74-45a9-8461-87be84b592c1
STYTCH_PROJECT_SECRET=secret-test-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Filled in automatically by ./setup-clients.sh --------------------------
# (M2M client_id / client_secret pairs for each scope combination)
READ_CLIENT_ID=
READ_CLIENT_SECRET=
WRITE_CLIENT_ID=
WRITE_CLIENT_SECRET=
BOTH_CLIENT_ID=
BOTH_CLIENT_SECRET=
NONE_CLIENT_ID=
NONE_CLIENT_SECRET=
