# Copy to .env.local and fill in. .env.local is git-ignored.
# All four come from the Stytch dashboard → Project settings.

# Frontend SDK public token (Project settings → API keys → "public_token")
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=public-token-test-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Project credentials (only needed if you script anything server-side; the UI
# itself only needs the public token).
STYTCH_PROJECT_ID=project-test-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
STYTCH_PROJECT_SECRET=secret-test-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Stytch CUSTOM AUTH DOMAIN as a full https URL (CNAME -> Stytch).
# This is what makes the token issuer a real URL so the MCP server's PRM works.
# e.g. https://auth.yourcompany.com
STYTCH_DOMAIN=https://auth.example.com
