# Copy to .env.cas and fill in. .env.cas is git-ignored.
# Used by run-mcp-server.sh to point the Couchbase MCP server at Stytch.

# --- Stytch (Connected Apps) — from dashboard -------------------------------
STYTCH_PROJECT_ID=project-test-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Your Stytch CUSTOM AUTH DOMAIN as a full https URL (CNAME -> Stytch).
# With a custom domain, issued tokens use this as the `iss` claim (a real URL),
# which is what lets the MCP server run in PRM mode.
STYTCH_DOMAIN=https://auth.example.com

# --- MCP server -------------------------------------------------------------
# Public base URL where the MCP server publishes Protected Resource Metadata.
MCP_BASE_URL=http://localhost:8000

# Audience the server requires. Stytch Connected Apps tokens default to the
# project id. VERIFY by decoding a real token (see README) and override if your
# client uses RFC 8707 resource indicators that change `aud`.
MCP_AUDIENCE=project-test-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Couchbase cluster ------------------------------------------------------
CB_CONNECTION_STRING=couchbases://localhost
CB_USERNAME=Administrator
CB_PASSWORD=password
